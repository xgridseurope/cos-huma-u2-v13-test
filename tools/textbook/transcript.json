   "kind": "figtext",
   "bbox_upload_px": [
    684,
    1524,
    956,
    1616
   ],
   "text": "Quan estirem el braç, el tríceps es contreu.",
   "crop_sha256": "5a19ea2499a9bbaf111ff0eb9c5b21cf69a5f523bf14b1128802eadd9f65a529"
  },
