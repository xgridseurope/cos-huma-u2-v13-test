   "kind": "text",
   "bbox_upload_px": [
    185,
    357,
    610,
    558
   ],
   "text": "La musculatura està formada per més de 600 músculs esquelètics que es distribueixen en tres zones del cos.",
   "crop_sha256": "91610b53e6c8f0eaa0ecd6cc68706a7c074eda63667e6cf73caad589c648b3d8"
